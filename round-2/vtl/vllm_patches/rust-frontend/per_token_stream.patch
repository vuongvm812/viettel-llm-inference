+    // --- vtl: per-token streaming (VTL_STREAM_PER_TOKEN) ---
+    //
+    // The N-step decode burst delivers N tokens in ONE engine record. Stock concatenates
+    // them into a single `TextDelta`, which makes a chunk-counting benchmark report TPOT N
+    // times worse than reality. These tests pin the split and, more importantly, pin that
+    // the union of the emitted events is still exactly the record's token ids in order.
+
+    /// Collect the intermediate (streaming) events for one multi-token record.
+    async fn stream_events(token_ids: Vec<u32>) -> Vec<DecodedTextEvent> {
+        use futures::StreamExt as _;
+        let prompt: Arc<[u32]> = Arc::from([]);
+        let raw_stream =
+            stream::iter(vec![Ok(GenerateOutput::for_test(Some(prompt), token_ids, None))]);
+        let tokenizer: DynTokenizer = Arc::new(TestTokenizer::new());
+        let mut out = Vec::new();
+        let mut s = Box::pin(decoded_text_event_stream(
+            "test".into(),
+            tokenizer,
+            raw_stream,
+            TextDecodeOptions::default(),
+            true,
+        ));
+        while let Some(ev) = s.next().await {
+            match ev {
+                Ok(ev) => out.push(ev),
+                // The stream ends by erroring when the raw stream closes without a
+                // terminal output, which is exactly what a mid-generation record does.
+                Err(_) => break,
+            }
+        }
+        out
     }
+
+    fn deltas(events: &[DecodedTextEvent]) -> Vec<(String, Vec<u32>)> {
+        events
+            .iter()
+            .filter_map(|e| match e {
+                DecodedTextEvent::TextDelta { delta, token_ids, .. } => {
+                    Some((delta.clone(), token_ids.clone()))
+                }
+                _ => None,
+            })
+            .collect()
+    }
+
+    #[tokio::test]
+    async fn burst_record_streams_one_delta_per_token() {
+        let toks = ascii_tokens("abcd");
+        let got = deltas(&stream_events(toks.clone()).await);
+        assert_eq!(got.len(), 4, "one chunk per token, not one per record: {got:?}");
+        assert_eq!(
+            got.iter().map(|(d, _)| d.as_str()).collect::<String>(),
+            "abcd"
+        );
+        // The union of the token ids is the record's, in order, with no duplicates.
+        let seen: Vec<u32> = got.iter().flat_map(|(_, ids)| ids.clone()).collect();
+        assert_eq!(seen, toks);
+    }
+
+    #[tokio::test]
+    async fn a_single_token_record_takes_the_stock_path() {
+        let got = deltas(&stream_events(ascii_tokens("a")).await);
+        assert_eq!(got, vec![("a".to_string(), vec![97])]);
+    }
+
+    #[tokio::test]
+    async fn per_token_split_is_env_revertible() {
+        // SAFETY: single-threaded test, and the value is restored before returning.
+        unsafe { std::env::set_var("VTL_STREAM_PER_TOKEN", "0") };
+        let toks = ascii_tokens("abcd");
+        let got = deltas(&stream_events(toks.clone()).await);
+        unsafe { std::env::remove_var("VTL_STREAM_PER_TOKEN") };
+        assert_eq!(got.len(), 1, "VTL_STREAM_PER_TOKEN=0 must restore stock");
+        assert_eq!(got[0], ("abcd".to_string(), toks));
+    }
