+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// Golden cross-language vectors. The identical hex strings are asserted by the Python
+    /// packer's self-check in `round-2/vtl/patches/shm_ipc.py::_self_check`; if either side
+    /// changes the layout, both tests fail.
+    const GOLDEN_PLAIN_DECODE: &str = concat!(
+        "01",
+        "0000",
+        "07000000",
+        "000000000000f03f",
+        "01000000",
+        "00000000",
+        "06000000",
+        "01000000",
+        "00000000",
+        "00",
+        "00",
+        "0000",
+        "00000000",
+        "7265712d3161",
+        "05000000",
+    );
+    const GOLDEN_FINISHED: &str = concat!(
+        "01",
+        "0000",
+        "00000000",
+        "0000000000000000",
+        "02000000",
+        "02000000",
+        "05000000",
+        "02000000",
+        "00000000",
+        "03",
+        "01",
+        "0000",
+        "02000000",
+        "7265712d61",
+        "03000000",
+        "04000000",
+        "05000000",
+        "00000000",
+        "00000000",
+        "01",
+        "02",
+        "0000",
+        "00000000",
+        "7265712d62",
+        "05000000",
+        "7265712d61",
+        "05000000",
+        "7265712d62",
+    );
+
+    fn decode_hex(hex: &str) -> Vec<u8> {
+        hex::decode(hex).expect("golden vector is valid hex")
+    }
+
+    #[test]
+    fn raw_decode_matches_golden_plain_decode() {
+        let outputs = decode_raw_outputs(&decode_hex(GOLDEN_PLAIN_DECODE)).unwrap();
+        let batch = outputs.as_request_batch().unwrap();
+        assert_eq!(batch.engine_index, 7);
+        assert_eq!(batch.timestamp, 1.0);
+        assert_eq!(batch.outputs.len(), 1);
+        assert_eq!(batch.outputs[0].request_id, "req-1a");
+        assert_eq!(batch.outputs[0].new_token_ids, vec![5]);
+        assert_eq!(batch.outputs[0].finish_reason, None);
+        assert_eq!(batch.outputs[0].stop_reason, None);
+        assert_eq!(batch.outputs[0].num_nans_in_logits, 0);
+        assert_eq!(batch.finished_requests, None);
+    }
+
+    #[test]
+    fn raw_decode_matches_golden_finished() {
+        let outputs = decode_raw_outputs(&decode_hex(GOLDEN_FINISHED)).unwrap();
+        let batch = outputs.as_request_batch().unwrap();
+        assert_eq!(batch.engine_index, 0);
+        assert_eq!(batch.outputs.len(), 2);
+        assert_eq!(batch.outputs[0].request_id, "req-a");
+        assert_eq!(batch.outputs[0].new_token_ids, vec![3, 4]);
+        assert_eq!(
+            batch.outputs[0].finish_reason,
+            Some(EngineCoreFinishReason::Length)
+        );
+        assert_eq!(batch.outputs[0].stop_reason, Some(StopReason::TokenId(2)));
+        assert_eq!(batch.outputs[1].request_id, "req-b");
+        assert!(batch.outputs[1].new_token_ids.is_empty());
+        assert_eq!(
+            batch.outputs[1].finish_reason,
+            Some(EngineCoreFinishReason::Abort)
+        );
+        assert_eq!(batch.outputs[1].stop_reason, None);
+        assert_eq!(
+            batch.finished_requests,
+            Some(std::collections::BTreeSet::from([
+                "req-a".to_string(),
+                "req-b".to_string()
+            ]))
+        );
+    }
+
+    #[test]
+    fn raw_decode_rejects_bad_records() {
+        // Wrong version.
+        let mut bad = decode_hex(GOLDEN_PLAIN_DECODE);
+        bad[0] = 2;
+        assert!(decode_raw_outputs(&bad).is_err());
+
+        // Truncated.
+        let short = decode_hex(GOLDEN_PLAIN_DECODE);
+        assert!(decode_raw_outputs(&short[..short.len() - 2]).is_err());
+
+        // Trailing garbage.
+        let mut long = decode_hex(GOLDEN_PLAIN_DECODE);
+        long.push(0);
+        assert!(decode_raw_outputs(&long).is_err());
+
+        // Empty body.
+        assert!(decode_raw_outputs(&[]).is_err());
+
+        // A hostile output count must come back as a decode error, NOT as a `with_capacity`
+        // of 4 billion elements (`handle_alloc_error` aborts the whole frontend).
+        let mut huge = decode_hex(GOLDEN_PLAIN_DECODE);
+        huge[15..19].copy_from_slice(&u32::MAX.to_le_bytes());
+        assert!(decode_raw_outputs(&huge).is_err());
+    }
+
+    /// The raw ADD record, byte for byte. Asserted verbatim by the Python landing's
+    /// `_self_check` (`GOLDEN_RAW_ADD` in `round-2/vtl/patches/shm_ipc.py`) minus nothing --
+    /// that constant carries the leading `TAG_RAW_ADD` byte the publisher prepends, so this
+    /// one is the same string with "10" in front.
+    const GOLDEN_RAW_ADD_BODY: &str = concat!(
+        "01",
+        "0000",
+        "03000000",
+        "01000000",
+        "02000000",
+        "2c010000",
+        // msgpack array16 of 20, request_id, then nil where the ids used to be.
+        "dc0014",
+        "ac",
+        "76746c2d676f6c64656e2d30",
+        "c0",
+        "c0c0c0",
+        "cb3ff8000000000000",
+        "c0c0c0c0c0",
+        "000000",
+        "c0c2c0c0c0",
+        "c2",
+    );
+
+    fn golden_request() -> EngineCoreRequest {
+        EngineCoreRequest {
+            request_id: "vtl-golden-0".to_string(),
+            prompt_token_ids: Some(vec![1, 2, 300]),
+            arrival_time: 1.5,
+            ..EngineCoreRequest::default()
+        }
+    }
+
+    #[test]
+    fn raw_add_matches_golden() {
+        let mut req = golden_request();
+        let body = encode_raw_add(&mut req).unwrap();
+        assert_eq!(hex::encode(&body), GOLDEN_RAW_ADD_BODY);
+        // The ids must be back where the msgpack fallback expects them.
+        assert_eq!(req.prompt_token_ids, Some(vec![1, 2, 300]));
+        // ...and the tail must be exactly the stock encoding with the ids dropped, which is
+        // what makes the engine's `add_request_decoder` work unchanged on it.
+        let mut stripped = golden_request();
+        stripped.prompt_token_ids = None;
+        assert_eq!(&body[7 + 4 * 3..], encode_msgpack(&stripped).unwrap());
+    }
+
+    #[test]
+    fn raw_add_refuses_a_request_without_prompt_ids() {
+        let mut req = golden_request();
+        req.prompt_token_ids = None;
+        assert!(encode_raw_add(&mut req).is_err());
+    }
+
+    #[test]
+    fn service_names_are_stable_and_address_scoped() {
+        let a = request_service("ipc:///tmp/in-a", 0);
+        let b = request_service("ipc:///tmp/in-b", 0);
+        assert_eq!(a, request_service("ipc:///tmp/in-a", 0));
+        assert_ne!(a, b);
+        assert_ne!(a, request_service("ipc:///tmp/in-a", 1));
+        assert!(a.starts_with("vtl/req/"));
+        assert!(output_service("ipc:///tmp/in-a").starts_with("vtl/out/"));
+        // Both channels share one seed so the two names stay paired.
+        assert_eq!(seed("ipc:///tmp/in-a").len(), 12);
+        // Golden cross-language literal, asserted verbatim by the Python `_self_check`
+        // (`GOLDEN_SEED_ADDRESS` / `GOLDEN_SEED`). The seed is implemented once per language,
+        // so without a shared vector a divergence would just give the two processes different
+        // service names -- i.e. a silent ZMQ-only boot, never an error.
+        assert_eq!(seed("ipc:///tmp/vllm-in-0"), "23c5030baa20");
+    }
+
+    #[test]
+    fn env_flag_only_accepts_truthy_values() {
+        // SAFETY: single-threaded test, and the key is unique to this test.
+        unsafe { std::env::set_var("VTL_SHM_IPC_TEST_FLAG", "1") };
+        assert!(env_flag("VTL_SHM_IPC_TEST_FLAG"));
+        unsafe { std::env::set_var("VTL_SHM_IPC_TEST_FLAG", "0") };
+        assert!(!env_flag("VTL_SHM_IPC_TEST_FLAG"));
+        unsafe { std::env::remove_var("VTL_SHM_IPC_TEST_FLAG") };
+        assert!(!env_flag("VTL_SHM_IPC_TEST_FLAG"));
+    }
