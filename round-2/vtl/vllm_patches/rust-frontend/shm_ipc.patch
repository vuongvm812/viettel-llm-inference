@@ -0,0 +1,840 @@
+//! iceoryx2 zero-copy shared-memory data plane for the frontend <-> EngineCore hop.
+//!
+//! Opt-in via `VTL_SHM_IPC=1`; with the flag unset **nothing in this module runs** and the
+//! client keeps the stock ZMQ transport. The Python counterpart lives in
+//! `round-2/vtl/patches/shm_ipc.py` and must agree with the constants below
+//! ([`SUBSCRIBER_MAX_BUFFER_SIZE`], [`HISTORY_SIZE`], [`ENABLE_SAFE_OVERFLOW`], the service
+//! names and the record framing) or `open_or_create` refuses to open the peer's service.
+//!
+//! Design notes:
+//! * ZMQ stays fully wired. The input (frontend -> engine) ROUTER half is retained inside
+//!   [`InputSink::Shm`] as the degrade path, and `transport::run_output_loop` keeps running
+//!   on the PULL socket — it is the free death detector (`ENGINE_CORE_DEAD` sentinel plus
+//!   socket disconnect), so engine-death behaviour is byte-for-byte the stock behaviour.
+//! * One shm channel carries **all** request types, so ordering is preserved (an ABORT can
+//!   never overtake the ADD it aborts — see the ordering comment in Python `core.py`).
+//! * Wakeups use the iceoryx2 event pattern (notifier/listener). The reader thread parks in
+//!   `blocking_wait_one()`, which matters on the 3-vCPU judge box: no busy-spin poller.
+//! * Service names are derived from the engine input address both sides already hold
+//!   (Rust: the bound `ConnectedTransport::input_address`; Python: `addresses.inputs[0]`),
+//!   so there is no extra plumbing and no cross-boot staleness.
+
+use core::sync::atomic::{AtomicBool, Ordering};
+use std::sync::OnceLock;
+
+use iceoryx2::node::Node;
+use iceoryx2::port::listener::Listener;
+use iceoryx2::port::notifier::Notifier;
+use iceoryx2::port::publisher::Publisher;
+use iceoryx2::port::subscriber::Subscriber;
+use iceoryx2::prelude::*;
+use iceoryx2::service::ipc_threadsafe::Service as ShmService;
+use iceoryx2::service::port_factory::event::PortFactory as EventFactory;
+use iceoryx2::service::port_factory::publish_subscribe::PortFactory as DataFactory;
+use sha2::{Digest, Sha256};
+use thiserror_ext::AsReport as _;
+use tokio::sync::mpsc;
+use tracing::{debug, info, trace, warn};
+use zeromq::RouterSendHalf;
+
+use crate::Error;
+use crate::error::Result;
+use crate::protocol::output::{
+    EngineCoreFinishReason, EngineCoreOutput, EngineCoreOutputs, RequestBatchOutputs, StopReason,
+    decode_engine_core_outputs,
+};
+use crate::protocol::encode_msgpack;
+use crate::protocol::request::EngineCoreRequest;
+use crate::transport::ConnectedEngine;
+
+/// Master switch. Everything in this module is inert unless this is truthy.
+pub const ENV_SHM_IPC: &str = "VTL_SHM_IPC";
+
+// --- service configuration; MUST stay identical to the Python side ------------------------
+const MAX_PUBLISHERS: usize = 1;
+const MAX_SUBSCRIBERS: usize = 1;
+const SUBSCRIBER_MAX_BUFFER_SIZE: usize = 512;
+const HISTORY_SIZE: usize = 0;
+/// iceoryx2 defaults to safe overflow: publishing into a FULL subscriber buffer silently
+/// overwrites the oldest unread sample — for a request stream that is a request that vanishes
+/// with no log and no error. Turning it off makes the condition observable: the setting is
+/// part of the service config (`open_or_create` refuses a peer that disagrees, so the Python
+/// side sets the same value) and with [`BackpressureStrategy::DiscardData`] a full buffer
+/// makes `send()` report 0 receivers — the same signal as "nobody subscribed", which already
+/// routes to the ZMQ fallback. The iceoryx2 default `RetryUntilDelivered` would instead spin
+/// the caller until the reader drains.
+///
+/// Backlog math for the 512-sample buffer: the scored trace peaks at 8 concurrent generations
+/// and the engine emits one output batch per decode step, so 512 samples is ~2 s of stream at
+/// a 4 ms TPOT. A peer that far behind is wedged, not busy.
+const ENABLE_SAFE_OVERFLOW: bool = false;
+/// Worst-case ADD payload (msgpack `EngineCoreRequest`) comfortably fits; the publisher's
+/// segment grows by powers of two if a request ever exceeds it.
+const REQUEST_MAX_PAYLOAD: usize = 1 << 20;
+// (the engine->frontend segment is sized on the Python side: OUTPUT_MAX_PAYLOAD = 1 << 18)
+
+// --- record framing; MUST stay identical to the Python side -------------------------------
+/// Output record tag: `[b'M'][msgpack EngineCoreOutputs]` (Phase A).
+pub const TAG_MSGPACK: u8 = b'M';
+/// Output record tag: `[b'R'][fixed little-endian struct]` (Phase B, `VTL_SHM_IPC_RAW=1`).
+pub const TAG_RAW: u8 = b'R';
+/// Output record tag: engine died; mirrors the ZMQ `ENGINE_CORE_DEAD` sentinel.
+pub const TAG_DEAD: u8 = b'D';
+
+/// Request record tag: raw ADD (`VTL_SHM_IPC_RAW_ADD=1`). Deliberately outside
+/// `EngineCoreRequestType`'s 0x00-0x03 so both tag spaces share the one ordered request
+/// channel, exactly as `TAG_MSGPACK`/`TAG_RAW` do on the output channel.
+pub const TAG_RAW_ADD: u8 = 0x10;
+/// Body layout version for [`TAG_RAW_ADD`]. The engine drops a frame it does not speak.
+pub const RAW_ADD_VERSION: u8 = 1;
+/// Opt-in for the raw ADD encoding. Requires [`ENV_SHM_IPC`].
+pub const ENV_SHM_IPC_RAW_ADD: &str = "VTL_SHM_IPC_RAW_ADD";
+
+/// True when `name` is set to a truthy value.
+fn env_flag(name: &str) -> bool {
+    std::env::var(name).is_ok_and(|value| {
+        matches!(
+            value.trim().to_ascii_lowercase().as_str(),
+            "1" | "true" | "yes" | "on"
+        )
+    })
+}
+
+/// Stable per-boot service-name seed shared by both processes.
+fn seed(input_address: &str) -> String {
+    hex::encode(Sha256::digest(input_address.as_bytes()))[..12].to_string()
+}
+
+fn request_service(input_address: &str, engine_index: u32) -> String {
+    format!("vtl/req/{}/{engine_index}", seed(input_address))
+}
+
+fn output_service(input_address: &str) -> String {
+    format!("vtl/out/{}", seed(input_address))
+}
+
+/// One logical channel: a byte-slice pub/sub service plus the event service that wakes its
+/// reader.
+type Channel = (DataFactory<ShmService, [u8], ()>, EventFactory<ShmService>);
+
+/// Open (or create) the byte-slice pub/sub service plus its companion event service.
+fn open_channel(node: &Node<ShmService>, name: &str) -> Result<Channel> {
+    let data: DataFactory<ShmService, [u8], ()> = node
+        .service_builder(&name.try_into().map_err(shm_error)?)
+        .publish_subscribe::<[u8]>()
+        .max_publishers(MAX_PUBLISHERS)
+        .max_subscribers(MAX_SUBSCRIBERS)
+        .subscriber_max_buffer_size(SUBSCRIBER_MAX_BUFFER_SIZE)
+        .history_size(HISTORY_SIZE)
+        .enable_safe_overflow(ENABLE_SAFE_OVERFLOW)
+        .open_or_create()
+        .map_err(shm_error)?;
+    let event: EventFactory<ShmService> = node
+        .service_builder(&format!("{name}/ev").as_str().try_into().map_err(shm_error)?)
+        .event()
+        .max_notifiers(MAX_PUBLISHERS)
+        .max_listeners(MAX_SUBSCRIBERS)
+        .open_or_create()
+        .map_err(shm_error)?;
+    Ok((data, event))
+}
+
+fn shm_error(error: impl core::fmt::Display) -> Error {
+    Error::Decode {
+        target_type: "iceoryx2",
+        message: error.to_string(),
+    }
+}
+
+/// Frontend -> engine shm publisher (all request types, one ordered channel).
+pub(crate) struct ShmInput {
+    publisher: Publisher<ShmService, [u8], ()>,
+    notifier: Notifier<ShmService>,
+    // The ports borrow nothing from the node, but the node owns this process' iceoryx2
+    // registration: dropping it would tear the services down under us.
+    _node: Node<ShmService>,
+}
+
+impl ShmInput {
+    fn connect(input_address: &str, engine_index: u32) -> Result<Self> {
+        let node = NodeBuilder::new().create::<ShmService>().map_err(shm_error)?;
+        let name = request_service(input_address, engine_index);
+        let (data, event) = open_channel(&node, &name)?;
+        let publisher: Publisher<ShmService, [u8], ()> = data
+            .publisher_builder()
+            .initial_max_slice_len(REQUEST_MAX_PAYLOAD)
+            .allocation_strategy(AllocationStrategy::PowerOfTwo)
+            // With safe overflow off, this is what a full engine buffer does: report
+            // (`send()` -> 0 receivers) instead of spinning this request's task.
+            .backpressure_strategy(BackpressureStrategy::DiscardData)
+            .create()
+            .map_err(shm_error)?;
+        let notifier: Notifier<ShmService> =
+            event.notifier_builder().create().map_err(shm_error)?;
+        info!(service = name, "vtl shm_ipc: request channel ready");
+        Ok(Self {
+            publisher,
+            notifier,
+            _node: node,
+        })
+    }
+
+    /// Publish `[request_type][payload]` into a loaned shm buffer and notify the engine.
+    ///
+    /// Returns `false` when nobody is subscribed — i.e. the engine side does not have
+    /// `VTL_SHM_IPC=1` — so the caller can fall back to ZMQ.
+    fn send(&self, request_type: u8, payload: &[u8]) -> Result<bool> {
+        let mut sample = self.publisher.loan_slice_uninit(payload.len() + 1).map_err(shm_error)?;
+        {
+            // One memcpy straight into the shm segment: the msgpack bytes are never copied
+            // again between here and the engine's decoder.
+            let buffer = sample.payload_mut();
+            buffer[0].write(request_type);
+            // SAFETY: `MaybeUninit<u8>` is `#[repr(transparent)]` over `u8`, so an
+            // initialized `&[u8]` is a valid `&[MaybeUninit<u8>]` source for the copy.
+            let tail =
+                unsafe { core::mem::transmute::<&[u8], &[core::mem::MaybeUninit<u8>]>(payload) };
+            buffer[1..].copy_from_slice(tail);
+        }
+        // SAFETY: every byte of the loaned slice was written above.
+        let sample = unsafe { sample.assume_init() };
+        let receivers = sample.send().map_err(shm_error)?;
+        if receivers == 0 {
+            return Ok(false);
+        }
+        let _ = self.notifier.notify().map_err(shm_error)?;
+        trace!(
+            request_type,
+            len = payload.len(),
+            "vtl shm_ipc: request sent"
+        );
+        Ok(true)
+    }
+}
+
+/// Where `ClientInner` writes engine-bound requests.
+///
+/// `Zmq` is the stock path. `Shm` publishes into shared memory but keeps the ROUTER half so a
+/// peer without `VTL_SHM_IPC=1` (or a channel that stops having a subscriber) degrades to the
+/// stock transport instead of dropping requests.
+pub(crate) enum InputSink {
+    Zmq(RouterSendHalf),
+    Shm {
+        // Boxed: the iceoryx2 ports are far larger than a `RouterSendHalf`, and this enum is
+        // stored inline in the `Arc<ClientInner>` shared by every request task.
+        shm: Box<ShmInput>,
+        zmq: RouterSendHalf,
+        /// Cleared for good the first time a publish finds no subscriber, so the transport
+        /// never flip-flops mid-stream (which could let an ABORT overtake its ADD).
+        live: AtomicBool,
+    },
+}
+
+impl InputSink {
+    /// The ZMQ half, always present.
+    pub(crate) fn zmq(&self) -> &RouterSendHalf {
+        match self {
+            Self::Zmq(zmq) => zmq,
+            Self::Shm { zmq, .. } => zmq,
+        }
+    }
+
+    /// Try the shm path. `Ok(true)` means the record was delivered and the caller is done;
+    /// `Ok(false)` means "not using shm, send it over ZMQ".
+    pub(crate) fn try_send_shm(&self, request_type: u8, payload: &[u8]) -> bool {
+        let Self::Shm { shm, live, .. } = self else {
+            return false;
+        };
+        if !live.load(Ordering::Relaxed) {
+            return false;
+        }
+        match shm.send(request_type, payload) {
+            Ok(true) => true,
+            Ok(false) => {
+                live.store(false, Ordering::Relaxed);
+                warn!("vtl shm_ipc: no engine subscriber, falling back to ZMQ for good");
+                false
+            }
+            Err(error) => {
+                // The latch is permanent on purpose: a per-message retry would interleave the
+                // two transports, and an already-published-but-unread record could then be
+                // overtaken by a later ZMQ one (an ABORT reaching the engine before its ADD).
+                live.store(false, Ordering::Relaxed);
+                warn!(error = %error.as_report(), "vtl shm_ipc: publish failed, falling back to ZMQ");
+                false
+            }
+        }
+    }
+}
+
+/// Build the request sink for this client. Returns the stock ZMQ sink unless `VTL_SHM_IPC=1`
+/// and the topology is the single-engine one the shm channel is defined for.
+pub(crate) fn build_input_sink(
+    input_address: &str,
+    engines: &[ConnectedEngine],
+    zmq: RouterSendHalf,
+) -> InputSink {
+    if !env_flag(ENV_SHM_IPC) {
+        return InputSink::Zmq(zmq);
+    }
+    let [engine] = engines else {
+        warn!(
+            engine_count = engines.len(),
+            "vtl shm_ipc: only the single-engine topology is supported, staying on ZMQ"
+        );
+        return InputSink::Zmq(zmq);
+    };
+    let Some(engine_index) = engine.engine_id.engine_index() else {
+        warn!(engine_id = ?engine.engine_id, "vtl shm_ipc: non-Python engine identity, staying on ZMQ");
+        return InputSink::Zmq(zmq);
+    };
+    match ShmInput::connect(input_address, engine_index) {
+        Ok(shm) => InputSink::Shm {
+            shm: Box::new(shm),
+            zmq,
+            live: AtomicBool::new(true),
+        },
+        Err(error) => {
+            warn!(error = %error.as_report(), "vtl shm_ipc: request channel setup failed, staying on ZMQ");
+            InputSink::Zmq(zmq)
+        }
+    }
+}
+
+/// `VTL_SHM_IPC_RAW_ADD=1` (and `VTL_SHM_IPC=1`), resolved once per process.
+pub(crate) fn raw_add_enabled() -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    *ON.get_or_init(|| env_flag(ENV_SHM_IPC) && env_flag(ENV_SHM_IPC_RAW_ADD))
+}
+
+/// Encode an ADD as a [`TAG_RAW_ADD`] body: the prompt token ids as a little-endian `u32`
+/// block, then the msgpack of the same 20-element `EngineCoreRequest` array with element 1
+/// (`prompt_token_ids`) nil.
+///
+/// Offsets below are from the start of the RECORD, i.e. including the tag byte the
+/// publisher prepends:
+///
+/// ```text
+/// [0]      u8      TAG_RAW_ADD
+/// [1]      u8      RAW_ADD_VERSION
+/// [2..4]   u16     reserved (0)
+/// [4..8]   u32 LE  n_tokens
+/// [8..8+4n]        n x u32 LE prompt token ids
+/// [8+4n..]         msgpack EngineCoreRequest, element 1 = nil
+/// ```
+///
+/// The reserved `u16` is what puts the id block on a 4-byte boundary inside the record, so
+/// the engine's `np.frombuffer` view is aligned and Rust may later read it as `&[u32]`.
+///
+/// WHY. The engine's ingest thread otherwise turns ~4400 msgpack ints into that many
+/// PyLongs per request with the GIL held; from this block it takes one `np.frombuffer`.
+///
+/// The ids are moved OUT of `req` for the msgpack pass and put back before returning, so a
+/// caller that falls through to the stock encoder sends an unchanged request.
+pub(crate) fn encode_raw_add(req: &mut EngineCoreRequest) -> Result<Vec<u8>> {
+    let Some(ids) = req.prompt_token_ids.take() else {
+        return Err(Error::Encode {
+            target_type: "EngineCoreRequest",
+            message: "raw ADD needs prompt_token_ids".to_string(),
+        });
+    };
+    let tail = encode_msgpack(req);
+    req.prompt_token_ids = Some(ids);
+    let tail = tail?;
+    // SAFETY of the cast: `prompt_token_ids` is a `Vec<u32>`, so its length is a `usize`
+    // bounded by the payload the frontend itself built; `REQUEST_MAX_PAYLOAD` (1 MiB,
+    // growable) is the real ceiling and a longer prompt fails the loan, not this.
+    let ids = req.prompt_token_ids.as_deref().unwrap_or_default();
+    let mut body = Vec::with_capacity(7 + 4 * ids.len() + tail.len());
+    body.push(RAW_ADD_VERSION);
+    body.extend_from_slice(&0u16.to_le_bytes());
+    body.extend_from_slice(&(ids.len() as u32).to_le_bytes());
+    for id in ids {
+        body.extend_from_slice(&id.to_le_bytes());
+    }
+    body.extend_from_slice(&tail);
+    Ok(body)
+}
+
+/// Start the engine -> frontend shm reader. It feeds the **same** mpsc channel as
+/// `transport::run_output_loop`, which stays running; both are no-ops until the engine
+/// actually publishes on their respective transports.
+pub(crate) fn spawn_output_thread(
+    input_address: &str,
+    tx: mpsc::Sender<Result<EngineCoreOutputs>>,
+) {
+    if !env_flag(ENV_SHM_IPC) {
+        return;
+    }
+    let name = output_service(input_address);
+    if let Err(error) =
+        std::thread::Builder::new().name("vtl-shm-out".to_string()).spawn(move || {
+            match run_output_loop(&name, &tx) {
+                Ok(()) => debug!("vtl shm_ipc: output loop exited"),
+                Err(error) => {
+                    // Abnormal exit: the engine may already have published records nobody
+                    // will ever read. Push the error into the SAME channel the outputs use
+                    // (like the TAG_DEAD path does) so the client surfaces the loss instead
+                    // of absorbing it as a silent stall.
+                    warn!(error = %error.as_report(), "vtl shm_ipc: output loop failed");
+                    let _ = tx.blocking_send(Err(error));
+                }
+            }
+        })
+    {
+        warn!(error = %error.as_report(), "vtl shm_ipc: could not spawn output thread");
+    }
+}
+
+fn run_output_loop(name: &str, tx: &mpsc::Sender<Result<EngineCoreOutputs>>) -> Result<()> {
+    let node = NodeBuilder::new().create::<ShmService>().map_err(shm_error)?;
+    let (data, event) = open_channel(&node, name)?;
+    let subscriber: Subscriber<ShmService, [u8], ()> =
+        data.subscriber_builder().create().map_err(shm_error)?;
+    let listener: Listener<ShmService> = event.listener_builder().create().map_err(shm_error)?;
+    info!(service = name, "vtl shm_ipc: output channel ready");
+
+    loop {
+        // Parks the thread on the iceoryx2 event primitive -- no polling, no spin.
+        listener.blocking_wait_one().map_err(shm_error)?;
+        while let Some(sample) = subscriber.receive().map_err(shm_error)? {
+            let record: &[u8] = sample.payload();
+            let Some((&tag, body)) = record.split_first() else {
+                warn!("vtl shm_ipc: empty output record");
+                continue;
+            };
+            let decoded = match tag {
+                TAG_DEAD => {
+                    warn!("vtl shm_ipc: received ENGINE_CORE_DEAD record from engine");
+                    let _ = tx.blocking_send(Err(Error::EngineCoreDead));
+                    return Ok(());
+                }
+                TAG_MSGPACK => decode_engine_core_outputs(&[body]),
+                TAG_RAW => decode_raw_outputs(body),
+                other => Err(Error::Decode {
+                    target_type: "EngineCoreOutputs",
+                    message: format!("unknown shm record tag {other:#04x}"),
+                }),
+            };
+            if tx.blocking_send(decoded).is_err() {
+                warn!("vtl shm_ipc: output rx dropped, shutting down output loop");
+                return Ok(());
+            }
+        }
+    }
+}
+
+// -------------------------------------------------------------------------------------------
+// Phase B: fixed-layout zero-copy decode records (`VTL_SHM_IPC_RAW=1` on the Python side).
+//
+// Every field is little-endian and unaligned-safe; nothing here allocates beyond the
+// `EngineCoreOutput` values the msgpack path would allocate anyway. The tag byte has already
+// been stripped by the caller, so offsets below are relative to `body` (i.e. record + 1).
+//
+//   body[0..1]   u8   format version (= RAW_VERSION)
+//   body[1..3]   u16  reserved, 0
+//   body[3..7]   u32  engine_index
+//   body[7..15]  f64  timestamp
+//   body[15..19] u32  num_outputs
+//   body[19..23] u32  num_finished
+//   then `num_outputs` records:
+//       +0   u32  request_id_len
+//       +4   u32  num_new_token_ids
+//       +8   u32  num_nans_in_logits
+//       +12  u8   flags: bit0 finish_reason present, bit1 stop_reason (token id) present
+//       +13  u8   finish_reason
+//       +14  u16  reserved, 0
+//       +16  u32  stop_reason token id
+//       +20  request_id (utf-8, request_id_len bytes)
+//       +..  num_new_token_ids * u32
+//   then `num_finished` entries: u32 length + utf-8 bytes.
+//
+// Anything the layout cannot express (logprobs, prompt logprobs, pooling output, events,
+// kv_transfer_params, trace headers, prefill stats, routed experts, scheduler stats, utility
+// outputs, DP wave control, a *string* stop_reason, multi-frame sends) makes the Python side
+// emit a TAG_MSGPACK record instead, so this decoder never has to handle it.
+// -------------------------------------------------------------------------------------------
+
+/// Bumped whenever the layout changes; a mismatch is a hard decode error, never a misparse.
+pub const RAW_VERSION: u8 = 1;
+const RAW_HEADER_LEN: usize = 23;
+const RAW_OUTPUT_HEAD_LEN: usize = 20;
+const FLAG_FINISH_REASON: u8 = 0b0000_0001;
+const FLAG_STOP_TOKEN: u8 = 0b0000_0010;
+
+fn raw_error(message: impl Into<String>) -> Error {
+    Error::Decode {
+        target_type: "EngineCoreOutputs",
+        message: message.into(),
+    }
+}
+
+/// Cursor over the record body. Every read is bounds-checked; a truncated record is a decode
+/// error handed to the dispatcher exactly like a malformed msgpack frame would be.
+struct Reader<'a> {
+    bytes: &'a [u8],
+    at: usize,
+}
+
+impl<'a> Reader<'a> {
+    fn take(&mut self, len: usize) -> Result<&'a [u8]> {
+        let end = self.at.checked_add(len).ok_or_else(|| raw_error("length overflow"))?;
+        let slice = self.bytes.get(self.at..end).ok_or_else(|| {
+            raw_error(format!(
+                "truncated raw record: need {end} bytes, have {}",
+                self.bytes.len()
+            ))
+        })?;
+        self.at = end;
+        Ok(slice)
+    }
+
+    fn u8(&mut self) -> Result<u8> {
+        Ok(self.take(1)?[0])
+    }
+
+    fn u16(&mut self) -> Result<u16> {
+        Ok(u16::from_le_bytes(
+            self.take(2)?.try_into().expect("2 bytes"),
+        ))
+    }
+
+    fn u32(&mut self) -> Result<u32> {
+        Ok(u32::from_le_bytes(
+            self.take(4)?.try_into().expect("4 bytes"),
+        ))
+    }
+
+    fn f64(&mut self) -> Result<f64> {
+        Ok(f64::from_le_bytes(
+            self.take(8)?.try_into().expect("8 bytes"),
+        ))
+    }
+
+    fn string(&mut self, len: usize) -> Result<String> {
+        core::str::from_utf8(self.take(len)?)
+            .map(str::to_owned)
+            .map_err(|error| raw_error(format!("invalid utf-8 in raw record: {error}")))
+    }
+
+    fn u32_vec(&mut self, count: usize) -> Result<Vec<u32>> {
+        let bytes = self.take(count * 4)?;
+        Ok(bytes
+            .chunks_exact(4)
+            .map(|chunk| u32::from_le_bytes(chunk.try_into().expect("4 bytes")))
+            .collect())
+    }
+}
+
+/// Decode one `TAG_RAW` record body into the same shape the msgpack decoder produces.
+pub fn decode_raw_outputs(body: &[u8]) -> Result<EngineCoreOutputs> {
+    if body.len() < RAW_HEADER_LEN {
+        return Err(raw_error(format!(
+            "raw record too short: {} < {RAW_HEADER_LEN}",
+            body.len()
+        )));
+    }
+    let mut reader = Reader { bytes: body, at: 0 };
+    let version = reader.u8()?;
+    if version != RAW_VERSION {
+        return Err(raw_error(format!(
+            "unsupported raw record version {version} (expected {RAW_VERSION})"
+        )));
+    }
+    if reader.u16()? != 0 {
+        return Err(raw_error("reserved header bits must be zero"));
+    }
+    let engine_index = reader.u32()?;
+    let timestamp = reader.f64()?;
+    let num_outputs = reader.u32()? as usize;
+    let num_finished = reader.u32()? as usize;
+
+    // One allocation per vec, same as the msgpack path; the payload itself is never copied
+    // out of shared memory beyond the request ids and token ids we must own.
+    //
+    // `num_outputs` comes off the wire, so the capacity is clamped by what the remaining
+    // bytes could POSSIBLY describe (every output costs at least its fixed head). Reserving
+    // the raw u32 would let a corrupt header ask for 4 billion elements, and a failed
+    // `Vec::with_capacity` aborts the process instead of returning the decode error below.
+    let capacity = num_outputs.min((body.len() - reader.at) / RAW_OUTPUT_HEAD_LEN);
+    let mut outputs = Vec::with_capacity(capacity);
+    for _ in 0..num_outputs {
+        if reader.bytes.len() - reader.at < RAW_OUTPUT_HEAD_LEN {
+            return Err(raw_error("truncated raw output record"));
+        }
+        let request_id_len = reader.u32()? as usize;
+        let num_new_token_ids = reader.u32()? as usize;
+        let num_nans_in_logits = reader.u32()?;
+        let flags = reader.u8()?;
+        let finish_reason_raw = reader.u8()?;
+        if reader.u16()? != 0 {
+            return Err(raw_error("reserved output bits must be zero"));
+        }
+        let stop_token = reader.u32()?;
+        let request_id = reader.string(request_id_len)?;
+        let new_token_ids = reader.u32_vec(num_new_token_ids)?;
+
+        let finish_reason = if flags & FLAG_FINISH_REASON != 0 {
+            Some(match finish_reason_raw {
+                0 => EngineCoreFinishReason::Stop,
+                1 => EngineCoreFinishReason::Length,
+                2 => EngineCoreFinishReason::Abort,
+                3 => EngineCoreFinishReason::Error,
+                4 => EngineCoreFinishReason::Repetition,
+                other => {
+                    return Err(raw_error(format!("unknown finish reason {other}")));
+                }
+            })
+        } else {
+            None
+        };
+
+        outputs.push(EngineCoreOutput {
+            request_id,
+            new_token_ids,
+            finish_reason,
+            stop_reason: (flags & FLAG_STOP_TOKEN != 0).then_some(StopReason::TokenId(stop_token)),
+            num_nans_in_logits,
+            ..Default::default()
+        });
+    }
+
+    let finished_requests = if num_finished == 0 {
+        None
+    } else {
+        let mut set = std::collections::BTreeSet::new();
+        for _ in 0..num_finished {
+            let len = reader.u32()? as usize;
+            set.insert(reader.string(len)?);
+        }
+        Some(set)
+    };
+
+    if reader.at != body.len() {
+        return Err(raw_error(format!(
+            "raw record has {} trailing byte(s)",
+            body.len() - reader.at
+        )));
+    }
+
+    Ok(EngineCoreOutputs::RequestBatch(RequestBatchOutputs {
+        engine_index,
+        outputs,
+        scheduler_stats: None,
+        timestamp,
+        finished_requests,
+    }))
+}
