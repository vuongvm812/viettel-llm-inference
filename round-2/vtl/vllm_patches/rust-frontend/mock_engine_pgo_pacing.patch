+/// Pace one decode step. With `delay_ms == 0` this just yields to the scheduler
+/// (original as-fast-as-possible behavior); otherwise it sleeps ~one decode-step
+/// latency so the frontend's streaming loop is profiled at production cadence.
+/// Takes a plain `u64` (not `&Engine`) so it borrows nothing across the select.
+async fn step_pacer(delay_ms: u64) {
+    if delay_ms == 0 {
+        yield_now().await;
+    } else {
+        tokio::time::sleep(Duration::from_millis(delay_ms)).await;
     }
 }
 
