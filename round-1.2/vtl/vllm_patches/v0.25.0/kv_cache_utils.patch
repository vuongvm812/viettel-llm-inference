+def _identify_drafter_layers(
+    vllm_config: VllmConfig, all_layer_names: list[str]
+) -> set[str] | None:
+    """Identify speculative-decode drafter layers so they can be isolated into
+    their own KV cache group(s).
+
+    Two conventions:
+    - EAGLE-style drafters append layers after the target's, so their global
+      index exceeds the target's total layer count.
+    - A classical (separate) draft model loads with prefix ``draft_model`` and
+      LOCAL 0-based indices (see vllm/v1/spec_decode/draft_model.py), which the
+      index rule misses -- detect those by name. (vLLM issue #49112 wall 1.)
+    """
+    if vllm_config.speculative_config is None:
+        return None
+    # Lazy import to avoid a core<-models import cycle at module load.
+    from vllm.model_executor.models.utils import extract_layer_index
+
+    target_num_layers = vllm_config.model_config.get_total_num_hidden_layers()
+    drafter_layers: set[str] = set()
+    for name in all_layer_names:
+        if "draft_model" in name:
+            drafter_layers.add(name)
+            continue
+        try:
+            if extract_layer_index(name) >= target_num_layers:
+                drafter_layers.add(name)
+        except (AssertionError, ValueError):
+            lowered = name.lower()
+            if "drafter" in lowered or "eagle" in lowered or "mtp" in lowered:
+                drafter_layers.add(name)
+    return drafter_layers or None
+
