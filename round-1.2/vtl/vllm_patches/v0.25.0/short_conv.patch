+def _vtl_mul_quant_eligible(out_proj) -> bool:
+    """True if ``out_proj`` can take a pre-quantized fp8 activation for the fused gate path.
+
+    Cached per-layer. Requires the flag on, the fused op registered, and ``out_proj`` on our
+    channelwise vtl_fp8 path: a column-major fp8 weight + per-channel ``weight_scale``, no bias,
+    not Marlin, and TP=1 (RowParallelLinear's all-reduce is not replicated here). Any miss ->
+    stock path, so this never changes numerics outside the exact config it checks for.
+    """
+    cached = getattr(out_proj, "_vtl_mul_quant_ok", None)
+    if cached is not None:
+        return cached
+    ok = False
+    try:
+        from vllm.distributed import get_tensor_model_parallel_world_size
+
+        weight = getattr(out_proj, "weight", None)
+        ok = (
+            _VTL_MUL_QUANT
+            and hasattr(torch.ops, "vllm_cuda")
+            and hasattr(torch.ops.vllm_cuda, "mul_dynamic_per_token_quant")
+            and weight is not None
+            and weight.dtype == torch.float8_e4m3fn
+            and getattr(out_proj, "weight_scale", None) is not None
+            and getattr(out_proj, "bias", None) is None
+            and not getattr(getattr(out_proj, "quant_method", None), "use_marlin", False)
+            and get_tensor_model_parallel_world_size() == 1
+        )
+    except Exception:
+        ok = False
+    out_proj._vtl_mul_quant_ok = ok
+    return ok
+
+
+def _vtl_conv_gate_eligible(layer, conv_weights, conv_state, state_indices, bcx) -> bool:
+    """True if the fused short-conv DECODE kernel can serve this layer.
+
+    Cached per-layer. On top of the flag and the op being registered, the shape predicate itself
+    lives in C++ (``bcx_conv_gate_supported``) so the vector width and block-size caps are not
+    re-hardcoded here. The kernel is specialised to conv width 3 / state_len 2 -- LFM2.5's
+    ``conv_L_cache = 3`` with the ``conv_kernel - 1`` state allocation -- and rejects anything else,
+    in which case the caller keeps the stock ``causal_conv1d_update``.
+    """
+    cached = getattr(layer, "_vtl_conv_gate_ok", None)
+    if cached is not None:
+        return cached
+    ok = False
+    try:
+        ok = (
+            _VTL_BCX_CONV_GATE
+            and hasattr(torch.ops, "vllm_cuda")
+            and hasattr(torch.ops.vllm_cuda, "bcx_conv_gate_quant")
+            and hasattr(torch.ops.vllm_cuda, "bcx_conv_gate_supported")
+            and bcx.dtype in (torch.bfloat16, torch.float16)
+            # The kernel reads B/C/x straight out of the merged in_proj output.
+            and bcx.dim() == 2
+            and bcx.stride(1) == 1
+            and bcx.shape[1] == 3 * conv_weights.shape[0]
+            # Same dtype for state and weights: stock does `x.to(conv_state.dtype)`, we don't.
+            and conv_state.dtype == bcx.dtype
+            and conv_weights.dtype == bcx.dtype
+            and conv_weights.stride(1) == 1
+            and conv_state.dim() == 3
+            and conv_state.shape[1] == conv_weights.shape[0]
+            and state_indices is not None
+            and state_indices.dtype == torch.int32
+            and torch.ops.vllm_cuda.bcx_conv_gate_supported(
+                conv_weights.shape[0], conv_weights.shape[1], conv_state.shape[2]
+            )
+        )
+    except Exception:
+        ok = False
+    layer._vtl_conv_gate_ok = ok
+    return ok
 
 
+def _vtl_out_proj_fp8(out_proj, y_fp8, y_scale, out_dtype):
+    """out_proj GEMM over an already-quantized activation.
+
+    Pre-quantized fp8 GEMM: weight is column-major [K, N] fp8, weight_scale per-channel [N, 1]
+    -- exactly what the stock Fp8 apply_weights passes to cutlass_scaled_mm (no padding at
+    dim=2048, no bias, TP=1; all guaranteed by ``_vtl_mul_quant_eligible``).
+    """
+    from vllm import _custom_ops as ops
+
+    return ops.cutlass_scaled_mm(
+        y_fp8,
+        out_proj.weight,
+        scale_a=y_scale,
+        scale_b=out_proj.weight_scale,
+        out_dtype=out_dtype,
+        bias=None,
+    )
+
