+# vtl Phase-3: fused conv-gate `y = C*Bx` + fp8 quant + out_proj, opt-in and fail-closed.
+# Also enables the shared per-layer fp8 STAGING BUFFER: out_proj is a single GEMM over the merged
+# decode|prefill tensor, so feeding it pre-quantized used to require a decode-only batch. Instead
+# both halves now write their fp8 rows into one `[num_actual_tokens, dim]` buffer and out_proj
+# consumes it whole -- which covers prefill-only and mixed batches too, and drops the bf16
+# `torch.vstack`. See round-1.2/vtl/patches/mul_quant.py and round-1.2/vtl/csrc/mul_quant.cu.
+_VTL_MUL_QUANT = _vtl_flag("VTL_ENABLE_MUL_QUANT")
+
+# vtl: replace the decode half of that path -- `(B_d*x_d).contiguous()`, the Triton
+# `causal_conv1d_update`, and the gate+quant -- with the single fused kernel in
+# round-1.2/vtl/csrc/bcx_conv_gate_quant.cu. Inert unless _VTL_MUL_QUANT is also on (it writes
+# into that staging buffer). See round-1.2/vtl/patches/bcx_conv_gate.py.
+_VTL_BCX_CONV_GATE = _vtl_flag("VTL_ENABLE_BCX_CONV_GATE")
+
+# The CUTLASS W4A8 kernel supports exactly one group size and rejects anything else in
+# can_implement(), so this cannot drift from round-1.2/vtl/patches/quant_w4a8.py:GROUP_SIZE
+# without the layer failing to build in the first place. Hardcoded rather than imported to
+# keep this file free of vtl imports.
+_VTL_W4A8_GROUP_SIZE = 128
+
+
+def _vtl_w4a8_out_proj(out_proj) -> bool:
+    """True if ``out_proj`` was quantized to int4 by round-1.2/vtl/patches/quant_w4a8.py.
+
+    Keys on the SAME single flag that quant_w4a8's own ``apply()`` keys on, deliberately, rather
+    than duck-typing the three packed attributes. Two predicates that mean "is this layer int4"
+    are two predicates that can disagree: the attributes appear one assignment before the flag
+    is set, and in that window a duck-typing check here would call cutlass_w4a8_mm against a
+    half-installed layer -- wrong numerics, not slow numerics. quant_w4a8 sets the flag last and
+    only inside its try, so the flag is true only when the layer is fully built.
+    """
+    return getattr(out_proj, "_vtl_w4a8_done", False)
+
+
+def _vtl_mul_quant_eligible(out_proj) -> bool:
+    """True if ``out_proj`` can take a pre-quantized fp8 activation for the fused gate path.
+
+    Cached per-layer. Requires the flag on, the fused op registered, no bias, not Marlin, and
+    TP=1 (RowParallelLinear's all-reduce is not replicated here), plus ``out_proj`` on one of
+    our two quantized paths -- both consume the SAME fp8 activation + per-token scale:
+
+      * vtl_w4a8: int4 ``weight_packed`` + group/channel scales -> ops.cutlass_w4a8_mm
+      * vtl_fp8:  column-major fp8 ``weight`` + per-channel ``weight_scale`` -> cutlass_scaled_mm
+
+    Any miss -> stock path, so this never changes numerics outside the configs it checks for.
+    """
+    cached = getattr(out_proj, "_vtl_mul_quant_ok", None)
+    if cached is not None:
+        return cached
+    ok = False
+    try:
+        from vllm.distributed import get_tensor_model_parallel_world_size
+
+        weight = getattr(out_proj, "weight", None)
+        quantized = _vtl_w4a8_out_proj(out_proj) or (
+            weight is not None
+            and weight.dtype == torch.float8_e4m3fn
+            and getattr(out_proj, "weight_scale", None) is not None
+        )
+        ok = (
+            _VTL_MUL_QUANT
+            and hasattr(torch.ops, "vllm_cuda")
+            and hasattr(torch.ops.vllm_cuda, "mul_dynamic_per_token_quant")
+            and quantized
+            and getattr(out_proj, "bias", None) is None
+            and not getattr(getattr(out_proj, "quant_method", None), "use_marlin", False)
+            and get_tensor_model_parallel_world_size() == 1
+        )
+    except Exception:
+        ok = False
+    out_proj._vtl_mul_quant_ok = ok
+    return ok
+
+
+def _vtl_conv_gate_eligible(layer, conv_weights, conv_state, state_indices, bcx) -> bool:
+    """True if the fused short-conv DECODE kernel can serve this layer.
+
+    Cached per-layer. On top of the flag and the op being registered, the shape predicate itself
+    lives in C++ (``bcx_conv_gate_supported``) so the vector width and block-size caps are not
+    re-hardcoded here. The kernel is specialised to conv width 3 / state_len 2 -- LFM2.5's
+    ``conv_L_cache = 3`` with the ``conv_kernel - 1`` state allocation -- and rejects anything else,
+    in which case the caller keeps the stock ``causal_conv1d_update``.
+    """
+    cached = getattr(layer, "_vtl_conv_gate_ok", None)
+    if cached is not None:
+        return cached
+    ok = False
+    try:
+        ok = (
+            _VTL_BCX_CONV_GATE
+            and hasattr(torch.ops, "vllm_cuda")
+            and hasattr(torch.ops.vllm_cuda, "bcx_conv_gate_quant")
+            and hasattr(torch.ops.vllm_cuda, "bcx_conv_gate_supported")
+            and bcx.dtype in (torch.bfloat16, torch.float16)
+            # The kernel reads B/C/x straight out of the merged in_proj output.
+            and bcx.dim() == 2
+            and bcx.stride(1) == 1
+            and bcx.shape[1] == 3 * conv_weights.shape[0]
+            # Same dtype for state and weights: stock does `x.to(conv_state.dtype)`, we don't.
+            and conv_state.dtype == bcx.dtype
+            and conv_weights.dtype == bcx.dtype
+            and conv_weights.stride(1) == 1
+            and conv_state.dim() == 3
+            and conv_state.shape[1] == conv_weights.shape[0]
+            and state_indices is not None
+            and state_indices.dtype == torch.int32
+            and torch.ops.vllm_cuda.bcx_conv_gate_supported(
+                conv_weights.shape[0], conv_weights.shape[1], conv_state.shape[2]
+            )
+        )
+    except Exception:
+        ok = False
+    layer._vtl_conv_gate_ok = ok
+    return ok
+
+
+def _vtl_out_proj_quantized(out_proj, y_fp8, y_scale, out_dtype):
+    """out_proj GEMM over an already-quantized activation.
+
+    This is the ONE place the fused short-conv path reaches the GEMM: the whole ShortConv
+    forward runs inside an opaque custom op, so no FX fusion pass can rewrite it and the call
+    is made by hand. Both arms take the same pre-quantized fp8 activation + per-token scale
+    that mul_quant/bcx_conv_gate just produced, so nothing upstream cares which one runs.
+    Preconditions (no padding at dim=2048, no bias, TP=1) come from _vtl_mul_quant_eligible.
+    """
+    from vllm import _custom_ops as ops
+
+    if _vtl_w4a8_out_proj(out_proj):
+        # int4 weights: group scales are consumed in the GEMM mainloop, the per-channel fp32
+        # residual and our per-token activation scale in the epilogue. Always emits bf16.
+        return ops.cutlass_w4a8_mm(
+            a=y_fp8,
+            b_q=out_proj.weight_packed,
+            b_group_scales=out_proj.weight_group_scale,
+            b_group_size=_VTL_W4A8_GROUP_SIZE,
+            a_token_scales=y_scale,
+            b_channel_scales=out_proj.weight_chan_scale,
+            # Read off the LAYER, never from os.environ. quant_w4a8.schedule() is the single
+            # process-wide read of VTL_W4A8_SCHEDULE and stamps the validated result here, so a
+            # sweep cannot apply to the other GEMMs but silently miss these ten conv out_projs.
+            maybe_schedule=getattr(out_proj, "_vtl_w4a8_schedule", None),
+        ).to(out_dtype)
+
+    # fp8 weights: column-major [K, N], weight_scale per-channel [N, 1] -- exactly what the
+    # stock Fp8 apply_weights passes to cutlass_scaled_mm.
+    return ops.cutlass_scaled_mm(
+        y_fp8,
+        out_proj.weight,
+        scale_a=y_scale,
+        scale_b=out_proj.weight_scale,
+        out_dtype=out_dtype,
+        bias=None,
+    )
+
