+def _vtl_env_on(name: str, default: str = "1") -> bool:
+    return os.environ.get(name, default).strip().lower() not in (
+        "0",
+        "false",
+        "no",
+        "off",
+        "",
+    )
+
+
+def _vtl_greedy_eligible(
+    num_draft_tokens: int,
+    temperature_np: np.ndarray,
+    max_num_logprobs: int,
+    max_per_req_token_ids: int,
+    use_penalty_np: np.ndarray,
+    use_logit_bias_np: np.ndarray,
+    num_bad_words_np: np.ndarray,
+) -> bool:
+    """Pure predicate: True iff a bare ``logits.argmax`` equals the token the
+    full sampler would produce for the *whole* batch.
+
+    ``temperature == 0`` is greedy, and ``min_p`` / ``top_k`` / ``top_p`` only
+    prune below the running max, so the argmax is invariant to them. Anything
+    that rewrites the logits -- penalties, logit bias (incl. min-tokens and
+    allowed-token-ids masks), bad-words -- or that needs processed logits
+    (logprobs) or introduces >1 candidate per row (spec-decode draft rows)
+    disqualifies the batch. Mirrors the V1 vtl ``_should_fastpath``. All args are
+    already sliced to the batch's request order (``idx_mapping_np``).
+    """
+    return (
+        num_draft_tokens == 0
+        and bool(np.all(temperature_np == 0.0))
+        and max_num_logprobs == NO_LOGPROBS
+        and max_per_req_token_ids == 0
+        and not bool(np.any(use_penalty_np))
+        and not bool(np.any(use_logit_bias_np))
+        and not bool(np.any(num_bad_words_np > 0))
+    )
+
