+    def _vtl_try_greedy(
+        self, logits: torch.Tensor, input_batch: InputBatch
+    ) -> SamplerOutput | None:
+        """Return a SamplerOutput via a bare argmax when the batch is a plain
+        greedy step, else None to fall through to the full ``sample`` path.
+
+        Output-identical to the stock path at temperature 0 -- gumbel_sample adds
+        no noise there, so it already reduces to argmax -- modulo the tie-break
+        direction on an exact-max logit tie, which torch.argmax and stock's Triton
+        tl.max both resolve to the first index (rare in fp32 over 65k; confirm with
+        the eval_quality trace diff). We just skip the wasted FP32 logit copy and
+        modifier kernels that precede it. num_sampled / num_rejected reuse the
+        stock helper so chunked-prefill rows (which sample no token) are still
+        counted correctly.
