+    def _vtl_argmax(self, logits: torch.Tensor) -> torch.Tensor:
+        """int64 argmax over the vocab, via the once-resolved backend."""
+        fn = self._vtl_argmax_fn
+        if fn is None:
+            fn = self._vtl_argmax_fn = self._vtl_resolve_argmax()
+        return fn(logits)
