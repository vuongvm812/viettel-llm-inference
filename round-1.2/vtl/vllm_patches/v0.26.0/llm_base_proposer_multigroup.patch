+    def _vtl_fused_argmax(self, hidden_states: torch.Tensor) -> torch.Tensor | None:
+        """Fused int4 GEMV + argmax over the draft head, or None to use the stock path.
+
+        Skips the `[rows, vocab]` logits tensor entirely. Only ever active on a DRAFT head that
+        vtl pruned AND packed a plain-layout int4 copy for -- see
+        round-1.2/vtl/patches/lm_head_quant.py and round-1.2/vtl/csrc/draft_argmax.cu. Returns
+        None for anything else, which is every path in stock vLLM.
+
+        Fail-closed: any miss or error falls through to `compute_logits(...).argmax(-1)`, which
+        is the same answer by construction (the packing is checked against a torch oracle in
+        bench/test_draft_argmax.py). The one thing this must not do is raise.
+        """
+        head = getattr(getattr(self, "model", None), "lm_head", None)
+        qweight = getattr(head, "vtl_argmax_qweight", None)
+        if qweight is None:
+            return None
+        try:
+            rows = hidden_states.reshape(-1, hidden_states.shape[-1])
+            tiles = head.vtl_argmax_tiles
+            n_rows = rows.shape[0]
+            # Workspace is cached on the layer and grown on demand: the draft batch is padded to
+            # a handful of cudagraph sizes, so this allocates a few times at warmup and never
+            # again -- and never inside a captured region.
+            buf = getattr(head, "_vtl_argmax_ws", None)
+            if buf is None or buf[0].shape[0] < n_rows:
+                buf = (
+                    torch.empty((n_rows, tiles), dtype=torch.float32, device=rows.device),
+                    torch.empty((n_rows, tiles), dtype=torch.int32, device=rows.device),
+                )
+                head._vtl_argmax_ws = buf
+            out = torch.empty(n_rows, dtype=torch.int64, device=rows.device)
+            torch.ops.vllm_cuda.draft_argmax(
+                out,
+                rows,
+                qweight,
+                head.vtl_argmax_group_scale,
+                buf[0][:n_rows],
+                buf[1][:n_rows],
+            )
+            return out.view(hidden_states.shape[:-1])
+        except Exception:
+            # Once, then never again -- a per-step warning on the decode path would cost more
+            # than the kernel saves.
+            if not getattr(self, "_vtl_argmax_failed", False):
+                self._vtl_argmax_failed = True
+                logger.warning(
+                    "vtl: fused draft argmax failed; falling back to logits+argmax",
+                    exc_info=True,
+                )
