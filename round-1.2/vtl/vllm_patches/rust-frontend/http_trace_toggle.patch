+/// Per-request HTTP tracing (`TraceLayer`) is on by default. Set
+/// `VLLM_RS_DISABLE_HTTP_TRACE=1` to drop the layer entirely — a latency A/B knob.
+/// The axum/tower/hyper logs are already WARN-pinned via `RUST_LOG`, so the span is
+/// filter-disabled anyway; this removes even its per-request construction cost.
+fn http_trace_enabled() -> bool {
+    !std::env::var("VLLM_RS_DISABLE_HTTP_TRACE")
+        .ok()
+        .is_some_and(|value| matches!(value.trim().to_lowercase().as_str(), "1" | "true"))
+}
