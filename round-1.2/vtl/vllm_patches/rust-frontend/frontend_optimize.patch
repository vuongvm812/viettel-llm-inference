+/// Deserialize `T` from a JSON byte slice with simd_json. simd_json mutates its
+/// input buffer (tape parser), so we copy into an owned `Vec` first.
+fn parse_json<T: DeserializeOwned>(bytes: &[u8]) -> Result<T, ApiError> {
+    let mut buf = bytes.to_vec();
+    simd_json::serde::from_slice(&mut buf)
+        .map_err(|err| ApiError::json_parse_error(err.to_string()))
+}
