+#[cfg(test)]
+mod tests {
+    use axum::http::{HeaderMap, HeaderValue, header};
+    use serde::Deserialize;
+    use serde_json::json;
+
+    use super::{is_json_content_type, parse_json};
+
+    #[derive(Debug, PartialEq, Deserialize)]
+    struct Sample {
+        model: String,
+        messages: Vec<serde_json::Value>,
+        max_tokens: Option<u32>,
+    }
+
+    // simd_json parse must match serde_json on a representative chat body,
+    // including an embedded serde_json::Value subtree (messages).
+    #[test]
+    fn simd_json_matches_serde_json() {
+        let body = json!({
+            "model": "LFM2.5-1.2B-Instruct",
+            "messages": [
+                {"role": "system", "content": "You are helpful."},
+                {"role": "user", "content": "Hi"}
+            ],
+            "max_tokens": 128
+        })
+        .to_string();
+
+        let via_simd: Sample = parse_json(body.clone().into_bytes()).unwrap();
+        let via_serde: Sample = serde_json::from_slice(body.as_bytes()).unwrap();
+        assert_eq!(via_simd, via_serde);
+        assert_eq!(via_simd.model, "LFM2.5-1.2B-Instruct");
+        assert_eq!(via_simd.messages.len(), 2);
+        assert_eq!(via_simd.max_tokens, Some(128));
+    }
+
+    #[test]
+    fn invalid_json_is_an_error() {
+        let bad = b"{not json".to_vec();
+        assert!(parse_json::<Sample>(bad).is_err());
+    }
+
+    fn headers_with_content_type(value: &str) -> HeaderMap {
+        let mut headers = HeaderMap::new();
+        headers.insert(header::CONTENT_TYPE, HeaderValue::from_str(value).unwrap());
+        headers
+    }
+
+    #[test]
+    fn content_type_guard_matches_axum_json() {
+        assert!(is_json_content_type(&headers_with_content_type("application/json")));
+        assert!(is_json_content_type(&headers_with_content_type(
+            "application/json; charset=utf-8"
+        )));
+        assert!(is_json_content_type(&headers_with_content_type("APPLICATION/JSON")));
+        assert!(is_json_content_type(&headers_with_content_type("application/ld+json")));
+
+        assert!(!is_json_content_type(&headers_with_content_type("text/plain")));
+        assert!(!is_json_content_type(&headers_with_content_type("application/xml")));
+        assert!(!is_json_content_type(&HeaderMap::new())); // missing header
+    }
+}
