+/// Deserialize `T` from a JSON body with simd_json. simd_json parses in place
+/// (destructive string unescaping), so it needs an owned mutable buffer. The
+/// caller moves the body `Bytes` in via `Bytes::into` — zero-copy when the body
+/// is uniquely owned (the common case), copying only if the buffer is shared.
+fn parse_json<T: DeserializeOwned>(mut buf: Vec<u8>) -> Result<T, ApiError> {
+    simd_json::serde::from_slice(&mut buf)
+        .map_err(|err| ApiError::json_parse_error(err.to_string()))
+}
+
+/// Accept `application/json` and `application/<x>+json` (with optional params),
+/// matching what axum's `Json` extractor required before we replaced it.
+fn is_json_content_type(headers: &HeaderMap) -> bool {
+    let Some(ct) = headers.get(header::CONTENT_TYPE).and_then(|v| v.to_str().ok()) else {
+        return false;
+    };
+    let essence = ct.split(';').next().unwrap_or("").trim();
+    const PREFIX: &str = "application/";
+    essence.eq_ignore_ascii_case("application/json")
+        || (essence.len() > PREFIX.len()
+            && essence[..PREFIX.len()].eq_ignore_ascii_case(PREFIX)
+            && essence.to_ascii_lowercase().ends_with("+json"))
+}
