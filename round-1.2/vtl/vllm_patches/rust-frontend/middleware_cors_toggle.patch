+/// CORS support (`CorsLayer` + the no-`Origin` header strip) is on by default.
+/// Set `VLLM_RS_DISABLE_CORS=1` to drop both layers — a latency A/B knob for
+/// server-to-server deployments (e.g. the judge harness) where no browser
+/// preflight ever occurs, so the two per-request layers are pure overhead.
+fn cors_enabled() -> bool {
+    !std::env::var("VLLM_RS_DISABLE_CORS")
+        .ok()
+        .is_some_and(|value| matches!(value.trim().to_lowercase().as_str(), "1" | "true"))
+}
